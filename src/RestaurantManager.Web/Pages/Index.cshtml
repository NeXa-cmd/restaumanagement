@page
@model IndexModel
@{
    ViewData["Title"] = "Menu";
}

<style>
    .menu-layout { display: flex; gap: 24px; }
    
    .filter-sidebar { width: 260px; flex-shrink: 0; }
    
    .filter-card {
        background: #fff;
        border-radius: 12px;
        padding: 24px;
        border: 1px solid #e2e8f0;
    }
    
    body.dark-mode .filter-card { background: #1e293b; border-color: #334155; }
    
    .filter-title {
        font-size: 14px;
        font-weight: 600;
        color: #64748b;
        margin-bottom: 16px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }
    
    .filter-item {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 10px 12px;
        border-radius: 8px;
        cursor: pointer;
        transition: all 0.15s;
        margin-bottom: 4px;
    }
    
    .filter-item:hover { background: #f1f5f9; }
    body.dark-mode .filter-item:hover { background: #334155; }
    
    .filter-item input[type="checkbox"] {
        width: 18px;
        height: 18px;
        accent-color: #4f46e5;
        cursor: pointer;
    }
    
    .filter-item label {
        flex: 1;
        cursor: pointer;
        font-size: 14px;
        color: #475569;
    }
    
    body.dark-mode .filter-item label { color: #94a3b8; }
    
    .filter-count {
        background: #e2e8f0;
        color: #64748b;
        font-size: 12px;
        padding: 2px 8px;
        border-radius: 10px;
        font-weight: 500;
    }
    
    body.dark-mode .filter-count { background: #334155; color: #94a3b8; }
    
    .btn-clear {
        margin-top: 16px;
        width: 100%;
        padding: 10px;
        background: transparent;
        color: #4f46e5;
        border: 1px solid #4f46e5;
        border-radius: 8px;
        cursor: pointer;
        font-size: 13px;
        font-weight: 500;
        transition: all 0.2s;
    }
    
    .btn-clear:hover { background: #4f46e5; color: #fff; }
    
    .menu-content { flex: 1; }
    
    .menu-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
        gap: 20px;
    }
    
    .menu-card {
        background: #fff;
        border-radius: 12px;
        overflow: hidden;
        border: 1px solid #e2e8f0;
        transition: all 0.2s;
    }
    
    body.dark-mode .menu-card { background: #1e293b; border-color: #334155; }
    
    .menu-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 25px rgba(0,0,0,0.1);
    }
    
    .menu-card-image {
        height: 140px;
        background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
    }
    
    .menu-card-image i { font-size: 40px; color: rgba(255,255,255,0.3); }
    
    .menu-card-badge {
        position: absolute;
        top: 12px;
        right: 12px;
        padding: 4px 10px;
        border-radius: 6px;
        font-size: 11px;
        font-weight: 600;
    }
    
    .menu-card-body { padding: 20px; }
    
    .menu-card-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 8px; }
    
    .menu-card-name {
        font-size: 16px;
        font-weight: 600;
        color: #1e293b;
        margin: 0;
    }
    
    body.dark-mode .menu-card-name { color: #f1f5f9; }
    
    .menu-card-price {
        font-size: 18px;
        font-weight: 700;
        color: #4f46e5;
    }
    
    .menu-card-desc {
        font-size: 13px;
        color: #64748b;
        line-height: 1.5;
        margin-bottom: 16px;
    }
    
    .menu-card-footer { display: flex; justify-content: space-between; align-items: center; }
    
    .menu-card-category {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: 12px;
        color: #4f46e5;
        background: rgba(79, 70, 229, 0.1);
        padding: 4px 10px;
        border-radius: 6px;
    }
    
    .btn-add {
        padding: 8px 16px;
        background: #4f46e5;
        color: #fff;
        border: none;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.2s;
        display: flex;
        align-items: center;
        gap: 6px;
    }
    
    .btn-add:hover { background: #4338ca; }
    .btn-add:disabled { background: #94a3b8; cursor: not-allowed; }
    
    .empty-state {
        text-align: center;
        padding: 80px 20px;
        color: #64748b;
    }
    
    .empty-state i { font-size: 48px; color: #cbd5e1; margin-bottom: 16px; }
    .empty-state h3 { font-size: 18px; color: #475569; margin-bottom: 8px; }
    body.dark-mode .empty-state h3 { color: #94a3b8; }
</style>

<div class="menu-layout">
    <aside class="filter-sidebar">
        <div class="filter-card">
            <h3 class="filter-title"><i class="fas fa-filter"></i> Categories</h3>
            <form method="get" id="filterForm">
                @foreach (var category in Model.Categories)
                {
                    var count = Model.GetCategoryCount(category);
                    <div class="filter-item">
                        <input type="checkbox" 
                               name="categories" 
                               value="@category" 
                               id="cat-@category.Replace(" ", "-")"
                               @(Model.SelectedCategories.Contains(category) ? "checked" : "")
                               onchange="this.form.submit()" />
                        <label for="cat-@category.Replace(" ", "-")">@category</label>
                        <span class="filter-count">@count</span>
                    </div>
                }
                
                @if (Model.SelectedCategories.Any())
                {
                    <button type="button" class="btn-clear" onclick="window.location.href='/'">
                        <i class="fas fa-times"></i> Clear Filters
                    </button>
                }
            </form>
        </div>
    </aside>
    
    <div class="menu-content">
        @if (Model.FilteredMenuItems.Any())
        {
            <div class="menu-grid">
                @foreach (var item in Model.FilteredMenuItems)
                {
                    <div class="menu-card">
                        <div class="menu-card-image">
                            <i class="fas fa-utensils"></i>
                            <span class="menu-card-badge @(item.IsAvailable ? "status-available" : "status-unavailable")">
                                @(item.IsAvailable ? "Available" : "Unavailable")
                            </span>
                        </div>
                        <div class="menu-card-body">
                            <div class="menu-card-header">
                                <h4 class="menu-card-name">@item.Name</h4>
                                <span class="menu-card-price">$@item.Price.ToString("F2")</span>
                            </div>
                            <p class="menu-card-desc">@item.Description</p>
                            <div class="menu-card-footer">
                                <span class="menu-card-category">
                                    <i class="fas fa-tag"></i> @item.Category
                                </span>
                                <form method="post" asp-page-handler="AddToCart" style="display:inline;">
                                    <input type="hidden" name="menuItemId" value="@item.Id" />
                                    <button type="submit" class="btn-add" @(item.IsAvailable ? "" : "disabled")>
                                        <i class="fas fa-cart-plus"></i>
                                        @(item.IsAvailable ? "Add" : "N/A")
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="empty-state">
                <i class="fas fa-utensils"></i>
                <h3>No menu items found</h3>
                <p>Try adjusting your filters to see more options</p>
            </div>
        }
    </div>
</div>

@page
@model RestaurantManager.Web.Pages.Admin.Users.IndexModel
@{
    ViewData["Title"] = "Manage Users";
}

<style>
    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 24px;
    }
    
    .table-container {
        background: #fff;
        border-radius: 12px;
        border: 1px solid #e2e8f0;
        overflow: hidden;
    }
    
    body.dark-mode .table-container { background: #1e293b; border-color: #334155; }
    
    table {
        width: 100%;
        border-collapse: collapse;
    }
    
    thead {
        background: #f8fafc;
        border-bottom: 1px solid #e2e8f0;
    }
    
    body.dark-mode thead { background: #0f172a; border-bottom-color: #334155; }
    
    th {
        padding: 16px;
        text-align: left;
        font-weight: 600;
        font-size: 13px;
        color: #64748b;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }
    
    td {
        padding: 16px;
        border-bottom: 1px solid #f1f5f9;
        color: #334155;
    }
    
    body.dark-mode td { border-bottom-color: #334155; color: #e2e8f0; }
    
    tbody tr:hover { background: #f8fafc; }
    body.dark-mode tbody tr:hover { background: #0f172a; }
    
    .user-name {
        font-weight: 600;
        color: #1e293b;
    }
    
    body.dark-mode .user-name { color: #f1f5f9; }
    
    .badge {
        display: inline-flex;
        align-items: center;
        padding: 4px 10px;
        border-radius: 6px;
        font-size: 12px;
        font-weight: 500;
    }
    
    .badge-active { background: #dcfce7; color: #166534; }
    .badge-inactive { background: #fee2e2; color: #991b1b; }
    .badge-admin { background: #dc2626; color: #fff; }
    .badge-cashier { background: #10b981; color: #fff; }
    
    body.dark-mode .badge-active { background: rgba(16,185,129,0.2); color: #6ee7b7; }
    body.dark-mode .badge-inactive { background: rgba(239,68,68,0.2); color: #fca5a5; }
</style>

<div class="page-header">
    <div>
        <h1 style="margin: 0; font-size: 24px; font-weight: 700;">Users</h1>
        <p style="margin: 4px 0 0 0; color: #64748b; font-size: 14px;">View and manage user accounts</p>
    </div>
</div>

<div class="table-container">
    <table>
        <thead>
            <tr>
                <th>Name</th>
                <th>Email</th>
                <th>Role</th>
                <th>Registered</th>
                <th>Orders</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model.Users)
            {
                <tr>
                    <td>
                        <div class="user-name">@user.FullName</div>
                    </td>
                    <td>@user.Email</td>
                    <td>
                        @if (user.Role == RestaurantManager.Domain.Entities.UserRole.Admin)
                        {
                            <span class="badge badge-admin">Admin</span>
                        }
                        else
                        {
                            <span class="badge badge-cashier">Cashier</span>
                        }
                    </td>
                    <td>@user.CreatedAt.ToString("MMM dd, yyyy")</td>
                    <td>@user.Orders.Count</td>
                    <td>
                        @if (user.IsActive)
                        {
                            <span class="badge badge-active">Active</span>
                        }
                        else
                        {
                            <span class="badge badge-inactive">Inactive</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

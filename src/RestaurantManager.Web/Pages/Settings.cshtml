@page
@model RestaurantManager.Web.Pages.SettingsModel
@{
    ViewData["Title"] = "Settings";
}

<style>
    .settings-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 24px; }
    
    .card {
        background: #fff;
        border-radius: 12px;
        border: 1px solid #e2e8f0;
        padding: 24px;
    }
    
    body.dark-mode .card { background: #1e293b; border-color: #334155; }
    
    .card-title {
        font-size: 14px;
        font-weight: 600;
        color: #1e293b;
        margin-bottom: 20px;
        display: flex;
        align-items: center;
        gap: 10px;
    }
    
    body.dark-mode .card-title { color: #f1f5f9; }
    
    .card-title i { color: #4f46e5; }
    
    .setting-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 16px 0;
        border-bottom: 1px solid #f1f5f9;
    }
    
    body.dark-mode .setting-item { border-bottom-color: #334155; }
    
    .setting-item:last-child { border-bottom: none; }
    
    .setting-info { flex: 1; }
    
    .setting-label { font-size: 14px; font-weight: 500; color: #1e293b; margin-bottom: 4px; }
    body.dark-mode .setting-label { color: #f1f5f9; }
    
    .setting-desc { font-size: 13px; color: #64748b; }
    
    .select-input {
        padding: 10px 14px;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        font-size: 14px;
        background: #fff;
        color: #1e293b;
        cursor: pointer;
    }
    
    body.dark-mode .select-input { background: #0f172a; border-color: #334155; color: #f1f5f9; }
    
    .danger-zone { border-color: #fecaca; }
    body.dark-mode .danger-zone { border-color: #7f1d1d; }
    
    .danger-zone .card-title { color: #dc2626; }
    body.dark-mode .danger-zone .card-title { color: #f87171; }
    
    .btn-danger {
        padding: 10px 20px;
        background: #dc2626;
        color: #fff;
        border: none;
        border-radius: 8px;
        font-size: 14px;
        font-weight: 500;
        cursor: pointer;
        transition: background 0.2s;
    }
    
    .btn-danger:hover { background: #b91c1c; }
    
    .btn-outline {
        padding: 10px 20px;
        background: transparent;
        color: #64748b;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        font-size: 14px;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.2s;
    }
    
    body.dark-mode .btn-outline { border-color: #334155; color: #94a3b8; }
    
    .btn-outline:hover { border-color: #4f46e5; color: #4f46e5; }
    
    .theme-toggle { display: flex; gap: 12px; margin-top: 12px; }
    
    .theme-btn {
        flex: 1;
        padding: 16px;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        background: #fff;
        cursor: pointer;
        transition: all 0.2s;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 8px;
        color: #64748b;
    }
    
    body.dark-mode .theme-btn { background: #0f172a; border-color: #334155; }
    
    .theme-btn:hover { border-color: #4f46e5; }
    
    .theme-btn.active { border-color: #4f46e5; background: rgba(79, 70, 229, 0.1); color: #4f46e5; }
    
    .theme-btn i { font-size: 24px; }
    .theme-btn span { font-weight: 500; font-size: 13px; }
</style>

<div class="settings-grid">
    <div class="card">
        <h3 class="card-title"><i class="fas fa-globe"></i> Preferences</h3>
        
        <div class="setting-item">
            <div class="setting-info">
                <div class="setting-label">Language</div>
                <div class="setting-desc">Select your preferred language</div>
            </div>
            <select class="select-input">
                <option>English</option>
                <option>Spanish</option>
                <option>French</option>
                <option>Arabic</option>
            </select>
        </div>
        
        <div class="setting-item">
            <div class="setting-info">
                <div class="setting-label">Currency</div>
                <div class="setting-desc">Display prices in your currency</div>
            </div>
            <select class="select-input">
                <option selected>MAD (د.م.)</option>
                <option>USD ($)</option>
                <option>EUR (€)</option>
                <option>GBP (£)</option>
            </select>
        </div>
        
        <div class="setting-item">
            <div class="setting-info">
                <div class="setting-label">Time Format</div>
                <div class="setting-desc">Choose 12 or 24 hour format</div>
            </div>
            <select class="select-input">
                <option>12 Hour</option>
                <option>24 Hour</option>
            </select>
        </div>
    </div>
    
    <div class="card">
        <h3 class="card-title"><i class="fas fa-palette"></i> Appearance</h3>
        
        <div class="setting-item" style="flex-direction: column; align-items: flex-start;">
            <div class="setting-info" style="margin-bottom: 12px;">
                <div class="setting-label">Theme</div>
                <div class="setting-desc">Choose your preferred theme</div>
            </div>
            <div class="theme-toggle">
                <button class="theme-btn" id="lightBtn" onclick="setLightTheme()">
                    <i class="fas fa-sun"></i>
                    <span>Light</span>
                </button>
                <button class="theme-btn" id="darkBtn" onclick="setDarkTheme()">
                    <i class="fas fa-moon"></i>
                    <span>Dark</span>
                </button>
            </div>
        </div>
    </div>
    
    <div class="card danger-zone">
        <h3 class="card-title"><i class="fas fa-exclamation-triangle"></i> Danger Zone</h3>
        
        <div class="setting-item">
            <div class="setting-info">
                <div class="setting-label">Clear Order History</div>
                <div class="setting-desc">Permanently delete all order history</div>
            </div>
            <button class="btn-outline" onclick="alert('This action cannot be undone!')">Clear</button>
        </div>
        
        <div class="setting-item">
            <div class="setting-info">
                <div class="setting-label">Delete Account</div>
                <div class="setting-desc">Permanently delete your account and data</div>
            </div>
            <button class="btn-danger" onclick="alert('This action cannot be undone!')">
                <i class="fas fa-trash-alt"></i> Delete
            </button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', updateThemeButtons);
        
        function setLightTheme() {
            document.body.classList.remove('dark-mode');
            localStorage.setItem('theme', 'light');
            updateThemeButtons();
        }
        
        function setDarkTheme() {
            document.body.classList.add('dark-mode');
            localStorage.setItem('theme', 'dark');
            updateThemeButtons();
        }
        
        function updateThemeButtons() {
            const isDark = document.body.classList.contains('dark-mode');
            document.getElementById('lightBtn').classList.toggle('active', !isDark);
            document.getElementById('darkBtn').classList.toggle('active', isDark);
        }
    </script>
}

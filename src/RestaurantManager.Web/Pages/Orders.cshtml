@page
@using RestaurantManager.Domain.Entities
@model RestaurantManager.Web.Pages.OrdersModel
@{
    ViewData["Title"] = "My Orders";
}

<style>
    .orders-tabs {
        display: flex;
        gap: 12px;
        margin-bottom: 24px;
    }
    
    .tab-btn {
        padding: 12px 24px;
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        font-size: 14px;
        font-weight: 500;
        color: #64748b;
        cursor: pointer;
        transition: all 0.2s;
        display: flex;
        align-items: center;
        gap: 8px;
    }
    
    body.dark-mode .tab-btn { background: #1e293b; border-color: #334155; color: #94a3b8; }
    
    .tab-btn:hover { border-color: #4f46e5; color: #4f46e5; }
    
    .tab-btn.active { background: #4f46e5; border-color: #4f46e5; color: #fff; }
    
    .tab-btn .count {
        background: rgba(0,0,0,0.1);
        padding: 2px 8px;
        border-radius: 10px;
        font-size: 12px;
    }
    
    .tab-btn.active .count { background: rgba(255,255,255,0.2); }
    
    .orders-list { display: flex; flex-direction: column; gap: 16px; }
    
    .order-card {
        background: #fff;
        border-radius: 12px;
        border: 1px solid #e2e8f0;
        overflow: hidden;
    }
    
    body.dark-mode .order-card { background: #1e293b; border-color: #334155; }
    
    .order-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        padding: 20px 24px;
        background: #f8fafc;
        border-bottom: 1px solid #e2e8f0;
    }
    
    body.dark-mode .order-header { background: #0f172a; border-bottom-color: #334155; }
    
    .order-info h3 {
        font-size: 16px;
        font-weight: 600;
        color: #1e293b;
        margin: 0 0 4px 0;
    }
    
    body.dark-mode .order-info h3 { color: #f1f5f9; }
    
    .order-meta {
        display: flex;
        align-items: center;
        gap: 16px;
        font-size: 13px;
        color: #64748b;
    }
    
    .order-meta span { display: flex; align-items: center; gap: 6px; }
    
    .order-status { text-align: right; }
    
    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 12px;
        border-radius: 6px;
        font-size: 12px;
        font-weight: 600;
    }
    
    .status-preparing { background: #fef3c7; color: #92400e; }
    .status-ready { background: #dbeafe; color: #1e40af; }
    .status-completed { background: #dcfce7; color: #166534; }
    .status-cancelled { background: #fee2e2; color: #991b1b; }
    
    body.dark-mode .status-preparing { background: rgba(245,158,11,0.2); color: #fcd34d; }
    body.dark-mode .status-ready { background: rgba(59,130,246,0.2); color: #93c5fd; }
    body.dark-mode .status-completed { background: rgba(16,185,129,0.2); color: #6ee7b7; }
    body.dark-mode .status-cancelled { background: rgba(239,68,68,0.2); color: #fca5a5; }
    
    .order-body { padding: 20px 24px; }
    
    .order-items { margin-bottom: 16px; }
    
    .order-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 12px 0;
        border-bottom: 1px solid #f1f5f9;
    }
    
    body.dark-mode .order-item { border-bottom-color: #334155; }
    
    .order-item:last-child { border-bottom: none; }
    
    .item-details { display: flex; align-items: center; gap: 12px; }
    
    .item-icon {
        width: 40px;
        height: 40px;
        background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%);
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: rgba(255,255,255,0.5);
        overflow: hidden;
        position: relative;
        flex-shrink: 0;
    }
    
    .item-icon img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        position: absolute;
        top: 0;
        left: 0;
    }
    
    .item-name { font-size: 14px; color: #475569; }
    body.dark-mode .item-name { color: #94a3b8; }
    
    .item-quantity { color: #94a3b8; font-size: 13px; }
    
    .item-price { font-weight: 600; color: #1e293b; }
    body.dark-mode .item-price { color: #f1f5f9; }
    
    .order-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding-top: 16px;
        border-top: 1px solid #e2e8f0;
    }
    
    body.dark-mode .order-footer { border-top-color: #334155; }
    
    .order-total { font-size: 16px; font-weight: 600; color: #1e293b; }
    body.dark-mode .order-total { color: #f1f5f9; }
    .order-total span { color: #4f46e5; font-size: 18px; }
    
    .btn-action {
        padding: 10px 20px;
        background: #4f46e5;
        color: #fff;
        border: none;
        border-radius: 8px;
        font-weight: 500;
        font-size: 14px;
        cursor: pointer;
        transition: all 0.2s;
        display: flex;
        align-items: center;
        gap: 8px;
    }
    
    .btn-action:hover { background: #4338ca; }
    
    .empty-state {
        text-align: center;
        padding: 80px 20px;
        color: #64748b;
    }
    
    .empty-state i { font-size: 48px; color: #cbd5e1; margin-bottom: 16px; }
    .empty-state h3 { font-size: 18px; color: #475569; margin-bottom: 8px; }
    body.dark-mode .empty-state h3 { color: #94a3b8; }
</style>

<div class="orders-tabs">
    <a href="/Orders?filter=active" class="tab-btn @(Model.CurrentFilter == "active" ? "active" : "")">
        <i class="fas fa-fire"></i> Active Orders
        <span class="count">@Model.ActiveOrdersCount</span>
    </a>
    <a href="/Orders?filter=past" class="tab-btn @(Model.CurrentFilter == "past" ? "active" : "")">
        <i class="fas fa-history"></i> Past Orders
        <span class="count">@Model.PastOrdersCount</span>
    </a>
</div>

<div class="orders-list">
    @if (Model.DisplayedOrders.Any())
    {
        @foreach (var order in Model.DisplayedOrders)
        {
            <div class="order-card">
                <div class="order-header">
                    <div class="order-info">
                        <h3>Order #@order.Id</h3>
                        <div class="order-meta">
                            <span><i class="far fa-calendar"></i> @order.OrderDate.ToString("MMM dd, yyyy")</span>
                            <span><i class="far fa-clock"></i> @order.OrderDate.ToString("hh:mm tt")</span>
                        </div>
                    </div>
                    <div class="order-status">
                        <span class="status-badge @GetStatusClass(order.Status)">
                            <i class="@GetStatusIcon(order.Status)"></i>
                            @order.Status
                        </span>
                    </div>
                </div>
                
                <div class="order-body">
                    <div class="order-items">
                        @foreach (var item in order.OrderItems)
                        {
                            <div class="order-item">
                                <div class="item-details">
                                    <div class="item-icon">
                                        @if (!string.IsNullOrEmpty(item.MenuItem?.ImageUrl))
                                        {
                                            <img src="@item.MenuItem.ImageUrl" alt="@item.MenuItem.Name" onerror="this.style.display='none';" />
                                        }
                                        <i class="fas fa-utensils"></i>
                                    </div>
                                    <div>
                                        <div class="item-name">@item.MenuItem?.Name</div>
                                        <div class="item-quantity">Qty: @item.Quantity</div>
                                    </div>
                                </div>
                                <span class="item-price">@item.UnitPrice.ToString("F2") MAD</span>
                            </div>
                        }
                    </div>
                    
                    <div class="order-footer">
                        <div class="order-total">Total: <span>@order.TotalAmount.ToString("F2") MAD</span></div>
                        @if (order.Status == OrderStatus.Completed)
                        {
                            <button class="btn-action"><i class="fas fa-redo"></i> Reorder</button>
                        }
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="empty-state">
            <i class="fas fa-box-open"></i>
            <h3>No @(Model.CurrentFilter == "active" ? "active" : "past") orders</h3>
            <p>@(Model.CurrentFilter == "active" ? "You don't have any orders being prepared right now." : "You haven't completed any orders yet.")</p>
        </div>
    }
</div>

@functions {
    string GetStatusClass(OrderStatus status)
    {
        return status switch
        {
            OrderStatus.Preparing => "status-preparing",
            OrderStatus.Ready => "status-ready",
            OrderStatus.Completed => "status-completed",
            OrderStatus.Cancelled => "status-cancelled",
            _ => "status-preparing"
        };
    }
    
    string GetStatusIcon(OrderStatus status)
    {
        return status switch
        {
            OrderStatus.Preparing => "fas fa-clock",
            OrderStatus.Ready => "fas fa-check-circle",
            OrderStatus.Completed => "fas fa-check-double",
            OrderStatus.Cancelled => "fas fa-times-circle",
            _ => "fas fa-clock"
        };
    }
}

@page
@model RestaurantManager.Web.Pages.CartModel
@{
    ViewData["Title"] = "Cart";
}

<style>
    .cart-layout { display: grid; grid-template-columns: 1fr 360px; gap: 24px; }
    
    @@media (max-width: 900px) { .cart-layout { grid-template-columns: 1fr; } }
    
    .cart-main { display: flex; flex-direction: column; gap: 16px; }
    
    .cart-card {
        background: #fff;
        border-radius: 12px;
        border: 1px solid #e2e8f0;
    }
    
    body.dark-mode .cart-card { background: #1e293b; border-color: #334155; }
    
    .cart-header {
        padding: 20px 24px;
        border-bottom: 1px solid #e2e8f0;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }
    
    body.dark-mode .cart-header { border-bottom-color: #334155; }
    
    .cart-header h2 {
        font-size: 16px;
        font-weight: 600;
        color: #1e293b;
        margin: 0;
        display: flex;
        align-items: center;
        gap: 10px;
    }
    
    body.dark-mode .cart-header h2 { color: #f1f5f9; }
    
    .cart-count {
        background: #4f46e5;
        color: #fff;
        padding: 4px 10px;
        border-radius: 6px;
        font-size: 12px;
        font-weight: 600;
    }
    
    .cart-item {
        display: flex;
        align-items: center;
        padding: 20px 24px;
        border-bottom: 1px solid #f1f5f9;
        transition: background 0.15s;
    }
    
    body.dark-mode .cart-item { border-bottom-color: #334155; }
    
    .cart-item:hover { background: #f8fafc; }
    body.dark-mode .cart-item:hover { background: #0f172a; }
    
    .cart-item:last-child { border-bottom: none; }
    
    .item-image {
        width: 64px;
        height: 64px;
        background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%);
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-right: 16px;
        flex-shrink: 0;
        color: rgba(255,255,255,0.4);
        overflow: hidden;
        position: relative;
    }
    
    .item-image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        position: absolute;
        top: 0;
        left: 0;
    }
    
    .item-details { flex: 1; }
    
    .item-name { font-size: 15px; font-weight: 600; color: #1e293b; margin-bottom: 4px; }
    body.dark-mode .item-name { color: #f1f5f9; }
    
    .item-price { font-size: 13px; color: #64748b; }
    
    .quantity-controls {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-right: 20px;
    }
    
    .qty-btn {
        width: 32px;
        height: 32px;
        border: 1px solid #e2e8f0;
        background: #fff;
        border-radius: 8px;
        font-size: 16px;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.15s;
        color: #475569;
    }
    
    body.dark-mode .qty-btn { background: #334155; border-color: #475569; color: #94a3b8; }
    
    .qty-btn:hover { background: #4f46e5; border-color: #4f46e5; color: #fff; }
    
    .qty-value { font-size: 15px; font-weight: 600; min-width: 24px; text-align: center; }
    
    .item-total { font-size: 16px; font-weight: 700; color: #4f46e5; min-width: 80px; text-align: right; }
    
    .remove-btn {
        background: none;
        border: none;
        color: #94a3b8;
        font-size: 16px;
        cursor: pointer;
        padding: 8px;
        margin-left: 8px;
        transition: color 0.15s;
    }
    
    .remove-btn:hover { color: #ef4444; }
    
    .cart-sidebar { position: sticky; top: 96px; }
    
    .summary-card {
        background: #fff;
        border-radius: 12px;
        border: 1px solid #e2e8f0;
        padding: 24px;
    }
    
    body.dark-mode .summary-card { background: #1e293b; border-color: #334155; }
    
    .summary-title {
        font-size: 16px;
        font-weight: 600;
        color: #1e293b;
        margin-bottom: 20px;
    }
    
    body.dark-mode .summary-title { color: #f1f5f9; }
    
    .summary-row {
        display: flex;
        justify-content: space-between;
        font-size: 14px;
        color: #64748b;
        margin-bottom: 12px;
    }
    
    .summary-row.total {
        font-size: 18px;
        font-weight: 700;
        color: #1e293b;
        padding-top: 16px;
        margin-top: 16px;
        border-top: 1px solid #e2e8f0;
    }
    
    body.dark-mode .summary-row.total { color: #f1f5f9; border-top-color: #334155; }
    
    .summary-row.total span:last-child { color: #4f46e5; }
    
    .btn-checkout {
        width: 100%;
        padding: 14px;
        background: #4f46e5;
        color: #fff;
        border: none;
        border-radius: 10px;
        font-size: 15px;
        font-weight: 600;
        cursor: pointer;
        transition: background 0.2s;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        margin-top: 20px;
    }
    
    .btn-checkout:hover { background: #4338ca; }
    
    .empty-state {
        text-align: center;
        padding: 80px 20px;
        color: #64748b;
    }
    
    .empty-state i { font-size: 48px; color: #cbd5e1; margin-bottom: 16px; }
    .empty-state h3 { font-size: 18px; color: #475569; margin-bottom: 8px; }
    body.dark-mode .empty-state h3 { color: #94a3b8; }
    
    .btn-browse {
        margin-top: 20px;
        padding: 12px 24px;
        background: #4f46e5;
        color: #fff;
        border: none;
        border-radius: 8px;
        font-weight: 500;
        cursor: pointer;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }
    
    .btn-browse:hover { background: #4338ca; color: #fff; }
</style>

@if (Model.UserCart != null && Model.UserCart.CartItems.Any())
{
    <div class="cart-layout">
        <div class="cart-main">
            <div class="cart-card">
                <div class="cart-header">
                    <h2><i class="fas fa-shopping-cart"></i> Your Cart</h2>
                    <span class="cart-count">@Model.UserCart.CartItems.Count items</span>
                </div>
                
                @foreach (var item in Model.UserCart.CartItems)
                {
                    <div class="cart-item">
                        <div class="item-image">
                            @if (!string.IsNullOrEmpty(item.MenuItem?.ImageUrl))
                            {
                                <img src="@item.MenuItem.ImageUrl" alt="@item.MenuItem.Name" onerror="this.style.display='none';" />
                            }
                            <i class="fas fa-utensils"></i>
                        </div>
                        <div class="item-details">
                            <div class="item-name">@item.MenuItem?.Name</div>
                            <div class="item-price">@((item.MenuItem?.Price ?? 0).ToString("F2")) MAD each</div>
                        </div>
                        <div class="quantity-controls">
                            <form method="post" asp-page-handler="UpdateQuantity" style="display:inline;">
                                <input type="hidden" name="cartItemId" value="@item.Id" />
                                <input type="hidden" name="quantity" value="@(item.Quantity - 1)" />
                                <button type="submit" class="qty-btn"><i class="fas fa-minus"></i></button>
                            </form>
                            <span class="qty-value">@item.Quantity</span>
                            <form method="post" asp-page-handler="UpdateQuantity" style="display:inline;">
                                <input type="hidden" name="cartItemId" value="@item.Id" />
                                <input type="hidden" name="quantity" value="@(item.Quantity + 1)" />
                                <button type="submit" class="qty-btn"><i class="fas fa-plus"></i></button>
                            </form>
                        </div>
                        <div class="item-total">@(((item.MenuItem?.Price ?? 0) * item.Quantity).ToString("F2")) MAD</div>
                        <form method="post" asp-page-handler="RemoveItem" style="display:inline;">
                            <input type="hidden" name="cartItemId" value="@item.Id" />
                            <button type="submit" class="remove-btn"><i class="fas fa-trash-alt"></i></button>
                        </form>
                    </div>
                }
            </div>
        </div>
        
        <aside class="cart-sidebar">
            <div class="summary-card">
                <h3 class="summary-title">Order Summary</h3>
                <div class="summary-row">
                    <span>Subtotal</span>
                    <span>@Model.Subtotal.ToString("F2") MAD</span>
                </div>
                <div class="summary-row">
                    <span>Tax (10%)</span>
                    <span>@Model.Tax.ToString("F2") MAD</span>
                </div>
                <div class="summary-row total">
                    <span>Total</span>
                    <span>@Model.Total.ToString("F2") MAD</span>
                </div>
                <form method="post" asp-page-handler="Checkout">
                    <button type="submit" class="btn-checkout">
                        <i class="fas fa-credit-card"></i>
                        Place Order
                    </button>
                </form>
            </div>
        </aside>
    </div>
}
else
{
    <div class="cart-card">
        <div class="empty-state">
            <i class="fas fa-shopping-cart"></i>
            <h3>Your cart is empty</h3>
            <p>Looks like you haven't added any items yet.</p>
            <a href="/" class="btn-browse"><i class="fas fa-utensils"></i> Browse Menu</a>
        </div>
    </div>
}
